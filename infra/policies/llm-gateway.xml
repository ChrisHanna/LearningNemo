<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(!context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).Equals(&quot;Bearer {{llm-gateway-client-key}}&quot;))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"message":"Invalid LLM gateway credential"}}</set-body>
        </return-response>
      </when>
    </choose>
    <set-header name="Authorization" exists-action="override">
      <value>Bearer {{openai-api-key}}</value>
    </set-header>
    <set-backend-service base-url="https://api.openai.com/v1" />
  </inbound>
  <backend>
    <forward-request timeout="120" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
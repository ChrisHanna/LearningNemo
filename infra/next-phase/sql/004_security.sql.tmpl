IF DATABASE_PRINCIPAL_ID(N'__CONTROL_PRINCIPAL__') IS NULL
    EXEC(N'CREATE USER [__CONTROL_PRINCIPAL__] WITH SID = __CONTROL_SID_HEX__, TYPE = E;');
IF DATABASE_PRINCIPAL_ID(N'__DIAGNOSTIC_PRINCIPAL__') IS NULL
    EXEC(N'CREATE USER [__DIAGNOSTIC_PRINCIPAL__] WITH SID = __DIAGNOSTIC_SID_HEX__, TYPE = E;');
IF DATABASE_PRINCIPAL_ID(N'__REMEDIATION_PRINCIPAL__') IS NULL
    EXEC(N'CREATE USER [__REMEDIATION_PRINCIPAL__] WITH SID = __REMEDIATION_SID_HEX__, TYPE = E;');

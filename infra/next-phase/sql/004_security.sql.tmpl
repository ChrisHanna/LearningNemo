    EXEC(N'CREATE USER [__QUERY_RUNNER_PRINCIPAL__] WITH SID = __QUERY_RUNNER_SID_HEX__, TYPE = E;');
EXEC(N'IF EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N''__CONTROL_PRINCIPAL__'' AND sid <> __CONTROL_SID_HEX__) THROW 51030, ''control_principal_sid_mismatch'', 1;');
EXEC(N'IF EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N''__DIAGNOSTIC_PRINCIPAL__'' AND sid <> __DIAGNOSTIC_SID_HEX__) THROW 51031, ''diagnostic_principal_sid_mismatch'', 1;');
EXEC(N'IF EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N''__REMEDIATION_PRINCIPAL__'' AND sid <> __REMEDIATION_SID_HEX__) THROW 51032, ''remediation_principal_sid_mismatch'', 1;');
EXEC(N'IF EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N''__VERIFIER_PRINCIPAL__'' AND sid <> __VERIFIER_SID_HEX__) THROW 51033, ''verifier_principal_sid_mismatch'', 1;');
EXEC(N'IF EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N''__QUERY_RUNNER_PRINCIPAL__'' AND sid <> __QUERY_RUNNER_SID_HEX__) THROW 51034, ''query_runner_principal_sid_mismatch'', 1;');
GO

